# ==========================================
# Woody Bot - Solana Memecoin Screener Configuration
# ==========================================

# Helius Enhanced Transactions & RPC (Free tier or Developer tier)
# Required for Check A (Holder Funding Trace) and genesis slot inspection
HELIUS_API_KEY=your_helius_api_key_here

# Vercel KV or Upstash Redis (For caching seen mints and token audits)
# Get these from Vercel Storage tab or console.upstash.com
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Optional Multi-Layer Confirmation Adapters
# Set to true to query GMGN smart money / security API (skips silently if blocked)
GMGN_ENABLED=false

# Complementary Momentum Validation Upgrade
# Comma-separated local Smart Money / KOL wallet addresses.
SMART_MONEY_WALLETS=
# Optional HTTP adapter for Twitter/X, OpenTwitter, or Nitter sentiment data.
# It receives ?ticker=...&mint=... and returns {"totalMentions": 100, "newAccountPct": 72}.
SOCIAL_SENTIMENT_API_URL=

# Optional Vercel Cron Security Secret (leave blank if not enforcing Authorization header)
CRON_SECRET=

# Privy public application identifier (browser-safe; never put a private key here)
# The control plane remains proposal-only and does not sign or submit transactions.
VITE_PRIVY_APP_ID=
